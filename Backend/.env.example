# Application Configuration
APP_NAME="AI Contract Reviewer"                      # (string) Application display name
APP_VERSION="1.0.0"                                  # (string) Application version
DEBUG=True                                           # (boolean) Enable/disable debug mode (True/False)
PRODUCTION=False                                      # (boolean) Set True in production to hide API docs (/docs, /redoc, /openapi.json)

# Database Configuration
DATABASE_URL="postgresql+asyncpg://postgres:your_password_here@localhost:5432/contract_reviewers" # (string) Async PostgreSQL connection URL

# Security & Authentication
SECRET_KEY="your_secret_key_here"                    # (string) Secret key for JWT token signing
ALGORITHM="HS256"                                    # (string) Algorithm used for JWT encoding/decoding
ACCESS_TOKEN_EXPIRE_MINUTES=30                       # (integer) JWT access token expiration duration in minutes

# Storage & Logging
UPLOAD_DIR="uploads/contracts"                       # (string) Relative path for uploaded contract files storage
LOG_LEVEL="INFO"                                     # (string) Logging severity level (DEBUG, INFO, WARNING, ERROR, CRITICAL)

# AI Engine & Vector Database Configuration
MODEL_NAME="BAAI/bge-small-en-v1.5"                  # (string) HuggingFace embedding model identifier
COLLECTION_NAME="contracts"                          # (string) ChromaDB vector store collection name
CHROMA_DB_PATH="ai_engine/vector_store"              # (string) Local file path to Chroma vector database
AI_MODEL_NAME="gemini-1.5-flash"                     # (string) Gemini AI model identifier
GEMINI_API_KEY="your_gemini_api_key_here"            # (string) Google Gemini API key
GOOGLE_API_KEY="your_google_api_key_here"            # (string) Google Cloud API key
LOCAL_LLM_URL="http://localhost:11434"                # (string) Local Ollama container server URL (fallback when API limit hit)
LOCAL_LLM_MODEL="llama3.2:3b"                         # (string) Local lightweight model identifier (e.g., llama3.2:3b or qwen2.5:1.5b)

# Redis Cache Configuration
REDIS_URL="redis://localhost:6379/0"                 # (string) Redis server connection URL

# Email Service Configuration
MAIL_USERNAME=""                                     # (string) SMTP server login username
MAIL_PASSWORD=""                                     # (string) SMTP server login password
MAIL_FROM="noreply@ai-contract-reviewer.com"         # (string) Sender email address for outgoing mail
MAIL_PORT=587                                        # (integer) SMTP server connection port
MAIL_SERVER="smtp.gmail.com"                         # (string) SMTP server host address
MAIL_FROM_NAME="AI Contract Reviewer"                # (string) Sender name displayed in outgoing emails
MAIL_STARTTLS=True                                   # (boolean) Enable STARTTLS encryption (True/False)
MAIL_SSL_TLS=False                                   # (boolean) Enable SSL/TLS encryption (True/False)

# One-Time Password (OTP) Configuration
OTP_LENGTH=6                                         # (integer) Number of digits in generated OTP
OTP_EXPIRE_SECONDS=300                               # (integer) Time-to-live for OTP in seconds
OTP_COOLDOWN_SECONDS=60                              # (integer) Minimum wait time between consecutive OTP requests in seconds
OTP_MAX_ATTEMPTS=5                                   # (integer) Maximum allowed failed OTP verification attempts

# Security & CORS Configuration
ALLOWED_ORIGINS=["https://localhost","https://127.0.0.1","http://localhost:3000","http://localhost:5173","http://localhost:5500"] # (list of strings) JSON-formatted list of allowed CORS origins in production
FORCE_HTTPS=False                                      # (boolean) Force HTTPS redirection middleware on FastAPI
SSL_CERTFILE=""                                        # (string) File path to SSL/TLS X.509 certificate file
SSL_KEYFILE=""                                         # (string) File path to SSL/TLS private key file
SECURE_COOKIES=True                                    # (boolean) Enforce Secure attribute on session cookies


